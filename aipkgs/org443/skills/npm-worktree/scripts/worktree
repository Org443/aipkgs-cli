#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(git rev-parse --git-common-dir)")" && pwd)"
REPO_NAME="$(basename "$REPO_ROOT")"
WORKTREE_BASE="$(dirname "$REPO_ROOT")/$REPO_NAME.worktrees"

if [ $# -eq 0 ]; then
  echo "Usage: ./worktree <branch-name> [-d]"
  exit 1
fi

BRANCH="$1"
DELETE="${2:-}"
WORKTREE_PATH="$WORKTREE_BASE/$BRANCH"

# Remove worktree
if [ "$DELETE" = "-d" ]; then
  echo "Removing worktree for branch '$BRANCH'..."
  git worktree remove "$WORKTREE_PATH"
  echo "Done! Removed worktree at $WORKTREE_PATH"
  exit 0
fi

# Create worktree
if [ -d "$WORKTREE_PATH" ]; then
  echo "Worktree already exists at $WORKTREE_PATH"
  exit 1
fi

mkdir -p "$WORKTREE_BASE"

echo "Creating worktree for branch '$BRANCH' at $WORKTREE_PATH..."
if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
  git worktree add "$WORKTREE_PATH" "$BRANCH"
else
  git worktree add -b "$BRANCH" "$WORKTREE_PATH"
fi


# Copy .env files from the current working tree to the new worktree
CURRENT_WORKTREE="$(git rev-parse --show-toplevel)"
ENV_COUNT=0
for env_file in "$CURRENT_WORKTREE"/.env*; do
  [ -f "$env_file" ] || continue
  cp "$env_file" "$WORKTREE_PATH/"
  ENV_COUNT=$((ENV_COUNT + 1))
  echo "  Copied $(basename "$env_file")"
done

echo "Installing dependencies in $WORKTREE_PATH..."
npm install --prefix "$WORKTREE_PATH"

echo "Done! Copied $ENV_COUNT .env file(s) to $WORKTREE_PATH"
