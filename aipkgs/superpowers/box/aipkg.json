      "subagent-driven-development": "aipkg://skill/superpowers/subagent-driven-development@latest",
      "executing-plans": "aipkg://skill/superpowers/executing-plans@latest",
      "finishing-a-development-branch": "aipkg://skill/superpowers/finishing-a-development-branch@latest",
      "test-driven-development": "aipkg://skill/superpowers/test-driven-development@latest",
      "systematic-debugging": "aipkg://skill/superpowers/systematic-debugging@latest",
      "verification-before-completion": "aipkg://skill/superpowers/verification-before-completion@latest",
      "requesting-code-review": "aipkg://skill/superpowers/requesting-code-review@latest",
      "receiving-code-review": "aipkg://skill/superpowers/receiving-code-review@latest",
      "dispatching-parallel-agents": "aipkg://skill/superpowers/dispatching-parallel-agents@latest",
      "using-git-worktrees": "aipkg://skill/superpowers/using-git-worktrees@latest",
